 {
  "name": "camera-keyframes: camera keyframes whose times decrease",
  "rule": "camera-keyframes",
  "scene": {
   "panels": {
    "main": {
     "camera": {
      "keyframes": [
       {
        "at": 1.0,
        "width": 2.0,
        "center": [
         0.0,
         0.0
        ],
        "ease": "smooth"
       },
       {
        "at": 3.0,
        "width": 4.0,
        "follow": [
         {
          "layer": 0,
          "member": 0
         },
         {
          "layer": 0,
          "member": 1
         }
        ],
        "offset": [
         0.5,
         0.0
        ],
        "ease": "smooth"
       },
       {
        "at": 6.0,
        "width": 4.0,
        "follow": [
         {
          "layer": 1,
          "member": 0
         }
        ],
        "ease": "in-out"
       },
       {
        "at": 0.5,
        "width": 8.0,
        "center": [
         4.0,
         1.0
        ],
        "ease": "linear"
       }
      ]
     }
    }
   }
  }
 },
