{
 "format": "tycho-scene",
 "version": "0.3",
 "requires": [
  "layers.arrows"
 ],
 "generator": "pytycho 0.2.0, spec/conformance/generate.py",
 "frames": {
  "rot": {},
  "inertial": {
   "parent": "rot",
   "rotation": {
    "axis": "z",
    "angle": {
     "channel": "th"
    }
   }
  }
 },
 "track_sets": {
  "loop": {
   "frame": "rot",
   "tracks": 1,
   "offsets": "loop/offsets",
   "positions": "loop/positions",
   "channels": {
    "th": {
     "view": "loop/th"
    },
    "vx": {
     "view": "loop/vx"
    },
    "vy": {
     "view": "loop/vy"
    }
   },
   "periodic": true
  }
 },
 "clock": {
  "mode": "fraction",
  "channels": [
   "@index"
  ],
  "steps": 10,
  "laps": 2
 },
 "views": {
  "rot": {
   "frame": "rot",
   "driver": {
    "sets": {
     "set": "loop"
    },
    "member": {
     "index": 0
    }
   },
   "layers": [
    {
     "kind": "arrow",
     "sets": {
      "set": "loop"
     },
     "members": {
      "index": 0
     },
     "vector": [
      "vx",
      "vy"
     ],
     "scale": 0.5
    }
   ]
  },
  "inertial": {
   "frame": "inertial",
   "driver": {
    "sets": {
     "set": "loop"
    },
    "member": {
     "index": 0
    }
   },
   "layers": [
    {
     "kind": "arrow",
     "sets": {
      "set": "loop"
     },
     "members": {
      "index": 0
     },
     "vector": [
      "vx",
      "vy"
     ],
     "scale": 0.5
    }
   ]
  }
 },
 "initial": {
  "variables": {},
  "clock": {
   "channel": "@index"
  },
  "panels": {
   "rot": {
    "view": "rot"
   },
   "inertial": {
    "view": "inertial"
   }
  },
  "layout": {
   "kind": "split",
   "dir": "row",
   "ratio": 0.5,
   "a": {
    "kind": "panel",
    "id": "rot"
   },
   "b": {
    "kind": "panel",
    "id": "inertial"
   }
  }
 }
}
