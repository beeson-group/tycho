[
 {
  "name": "two-samples: a trajectory of one sample",
  "rule": "two-samples",
  "scene": {
   "trajectory_sets": {
    "open": {
     "trajectories": 2,
     "offsets": "bad/one"
    }
   }
  }
 },
 {
  "name": "trajectory-set: offsets[0] is not 0",
  "rule": "trajectory-set",
  "scene": {
   "trajectory_sets": {
    "off": {
     "offsets": "bad/offsets"
    }
   }
  }
 },
 {
  "name": "identifier: a set channel named @index",
  "rule": "identifier",
  "scene": {
   "trajectory_sets": {
    "off": {
     "channels": {
      "@index": {
       "array": "bad/time"
      }
     }
    }
   }
  }
 },
 {
  "name": "identifier: a set parameter named @index",
  "rule": "identifier",
  "scene": {
   "trajectory_sets": {
    "off": {
     "parameters": {
      "@index": {
       "array": "bad/time"
      }
     }
    }
   }
  }
 },
 {
  "name": "monotone-clock-channel: a clock channel that is not monotone",
  "rule": "monotone-clock-channel",
  "scene": {
   "trajectory_sets": {
    "open": {
     "channels": {
      "t": {
       "array": "bad/t"
      }
     }
    }
   },
   "clock": {
    "channels": [
     "t"
    ]
   },
   "initial": {
    "clock": {
     "channel": "t"
    }
   }
  },
  "state": {
   "inputs": {},
   "clock": {
    "channel": "t"
   },
   "panels": {
    "open": {
     "panel": "open"
    }
   },
   "layout": {
    "kind": "panel",
    "id": "open"
   }
  }
 },
 {
  "name": "origin: a constant zero scale",
  "rule": "origin",
  "scene": {
   "frames": {
    "c": {
     "scale": 0
    }
   }
  }
 },
 {
  "name": "origin: an origin of two scalars",
  "rule": "origin",
  "scene": {
   "frames": {
    "c": {
     "origin": [
      1.0,
      0.0
     ]
    }
   }
  }
 },
 {
  "name": "frame: an edge field on the root",
  "rule": "frame",
  "scene": {
   "frames": {
    "p": {
     "scale": 2
    }
   }
  }
 },
 {
  "name": "context-number: @index in a frame edge",
  "rule": "context-number",
  "scene": {
   "frames": {
    "c": {
     "rotation": {
      "axis": "z",
      "angle": {
       "channel": "@index"
      }
     }
    }
   }
  }
 },
 {
  "name": "body-origin-cycle: an origin at a body in the frame it defines",
  "rule": "body-origin-cycle",
  "scene": {
   "bodies": {
    "loop": {
     "frame": "c",
     "position": [
      0,
      0,
      0
     ]
    }
   },
   "frames": {
    "c": {
     "origin": {
      "body": "loop"
     }
    }
   }
  }
 },
 {
  "name": "set-query: a {set} query naming no set",
  "rule": "set-query",
  "scene": {
   "panels": {
    "open": {
     "layers": [
      {
       "kind": "trajectories",
       "sets": {
        "set": "nope"
       },
       "members": "all"
      }
     ]
    }
   }
  }
 },
 {
  "name": "set-query: a reference trajectory query matching two sets",
  "rule": "set-query",
  "scene": {
   "trajectory_sets": {
    "open": {
     "tags": {
      "g": "x"
     }
    },
    "nokey": {
     "tags": {
      "g": "x"
     }
    }
   },
   "panels": {
    "open": {
     "reference": {
      "sets": {
       "set": null,
       "tags": {
        "g": "x"
       }
      }
     }
    }
   }
  }
 },
 {
  "name": "members: a literal index past the last trajectory",
  "rule": "members",
  "scene": {
   "panels": {
    "open": {
     "reference": {
      "sets": {
       "set": "open"
      },
      "member": {
       "index": 1
      }
     }
    }
   }
  }
 },
 {
  "name": "members: a reference trajectory member of all",
  "rule": "members",
  "scene": {
   "panels": {
    "open": {
     "reference": {
      "sets": {
       "set": "open"
      },
      "member": "all"
     }
    }
   }
  }
 },
 {
  "name": "clock-channel-carried: a reference trajectory set without the clock channel",
  "rule": "clock-channel-carried",
  "scene": {
   "trajectory_sets": {
    "nokey": {
     "channels": {
      "t": {
       "array": "bad/time"
      }
     }
    }
   },
   "clock": {
    "channels": [
     "t"
    ]
   },
   "initial": {
    "clock": {
     "channel": "t"
    }
   }
  },
  "state": {
   "inputs": {},
   "clock": {
    "channel": "t"
   },
   "panels": {
    "open": {
     "panel": "open"
    }
   },
   "layout": {
    "kind": "panel",
    "id": "open"
   }
  }
 },
 {
  "name": "clock-mode: epoch mode without a range",
  "rule": "clock-mode",
  "scene": {
   "clock": {
    "mode": "epoch"
   }
  }
 },
 {
  "name": "clock: a frame index that is not an integer",
  "rule": "clock",
  "frame_index": 0.5
 },
 {
  "name": "state: a panel showing an unknown panel",
  "rule": "state",
  "state": {
   "inputs": {},
   "clock": {
    "channel": "@index"
   },
   "panels": {
    "open": {
     "panel": "nope"
    }
   },
   "layout": {
    "kind": "panel",
    "id": "open"
   }
  }
 },
 {
  "name": "state: a layout showing a panel twice",
  "rule": "state",
  "state": {
   "inputs": {},
   "clock": {
    "channel": "@index"
   },
   "panels": {
    "open": {
     "panel": "open"
    }
   },
   "layout": {
    "kind": "split",
    "dir": "row",
    "ratio": 0.5,
    "a": {
     "kind": "panel",
     "id": "open"
    },
    "b": {
     "kind": "panel",
     "id": "open"
    }
   }
  }
 },
 {
  "name": "input: a parameter input holding a boolean",
  "rule": "input",
  "scene": {
   "inputs": {
    "k": {
     "kind": "parameter",
     "parameter": "@index",
     "default": 0
    }
   },
   "panels": {
    "open": {
     "reference": {
      "sets": {
       "set": "open"
      },
      "member": {
       "input": "k"
      }
     }
    }
   }
  },
  "state": {
   "inputs": {
    "k": true
   },
   "clock": {
    "channel": "@index"
   },
   "panels": {
    "open": {
     "panel": "open"
    }
   },
   "layout": {
    "kind": "panel",
    "id": "open"
   }
  }
 },
 {
  "name": "visible: visible naming a choice",
  "rule": "visible",
  "scene": {
   "inputs": {
    "c": {
     "kind": "choice",
     "values": [
      "x"
     ],
     "default": "x"
    }
   },
   "panels": {
    "open": {
     "layers": [
      {
       "kind": "grid",
       "visible": {
        "input": "c"
       }
      }
     ]
    }
   }
  }
 },
 {
  "name": "version: a layer kind that is not implemented",
  "rule": "version",
  "scene": {
   "panels": {
    "open": {
     "layers": [
      {
       "kind": "mesh"
      }
     ]
    }
   }
  }
 },
 {
  "name": "panel: a trail fraction above 1",
  "rule": "panel",
  "scene": {
   "panels": {
    "open": {
     "layers": [
      {
       "kind": "trajectories",
       "sets": {
        "set": "open"
       },
       "members": "all",
       "reveal": "trail",
       "trail": {
        "fraction": 1.5
       }
      }
     ]
    }
   }
  }
 }
]
