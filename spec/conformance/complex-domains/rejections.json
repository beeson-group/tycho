[
 {
  "name": "number-input: min not less than max",
  "rule": "number-input",
  "scene": {
   "inputs": {
    "T": {
     "kind": "number",
     "min": 2.0,
     "max": 1.0,
     "default": 1.0
    }
   }
  }
 },
 {
  "name": "number-input: a default above the maximum",
  "rule": "number-input",
  "scene": {
   "inputs": {
    "T": {
     "default": 3.0
    }
   }
  }
 },
 {
  "name": "keyframes: a morph alpha with a keyframe above 1, read before this keyframe",
  "rule": "keyframes",
  "scene": {
   "panels": {
    "main": {
     "layers": [
      {
       "kind": "morph",
       "map": "conformal_exp",
       "alpha": {
        "keyframes": [
         [
          0.0,
          0.0
         ],
         [
          5.0,
          2.0
         ]
        ]
       },
       "period": {
        "input": "T"
       },
       "items": [
        {
         "kind": "line",
         "from": [
          0.0,
          {
           "nyquist": -1.0
          }
         ],
         "to": [
          0.0,
          {
           "nyquist": 1.0
          }
         ],
         "samples": 3
        },
        {
         "kind": "line",
         "visible": {
          "input": "extra"
         },
         "from": [
          -1.0,
          0.0
         ],
         "to": [
          1.0,
          0.0
         ],
         "samples": 3
        },
        {
         "kind": "region",
         "u": [
          -1.0,
          0.0
         ],
         "v": [
          0.0,
          1.0
         ],
         "samples": [
          2,
          2
         ]
        },
        {
         "kind": "line",
         "from": [
          1e-05,
          0.0
         ],
         "to": [
          2e-05,
          1e-05
         ],
         "samples": 2
        }
       ]
      }
     ]
    }
   }
  }
 },
 {
  "name": "morph: unknown map kind",
  "rule": "morph",
  "scene": {
   "panels": {
    "main": {
     "frame": "s_plane",
     "reference": {
      "sets": {
       "set": "ref"
      },
      "member": {
       "index": 0
      }
     },
     "layers": [
      {
       "kind": "morph",
       "map": "linear",
       "alpha": 0.0,
       "period": 1.0,
       "items": []
      }
     ]
    }
   }
  }
 }
]
