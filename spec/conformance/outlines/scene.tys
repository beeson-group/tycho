{
 "format": "tycho-scene",
 "version": "0.3",
 "requires": [
  "layers.outline",
  "frames.origin_channel"
 ],
 "generator": "pytycho 0.2.0, spec/conformance/generate.py",
 "frames": {
  "rot": {},
  "zoom": {
   "parent": "rot",
   "origin": [
    {
     "channel": "mx"
    },
    {
     "channel": "my"
    },
    0.0
   ],
   "scale": {
    "channel": "k"
   }
  },
  "inertial": {
   "parent": "rot",
   "rotation": {
    "axis": "z",
    "angle": {
     "channel": "th"
    }
   }
  }
 },
 "track_sets": {
  "drv": {
   "frame": "rot",
   "tags": {
    "g": "drv"
   },
   "tracks": 1,
   "offsets": "drv/offsets",
   "positions": "drv/positions",
   "channels": {
    "t": {
     "view": "drv/t"
    },
    "mx": {
     "view": "drv/mx"
    },
    "my": {
     "view": "drv/my"
    },
    "k": {
     "view": "drv/k"
    },
    "th": {
     "view": "drv/th"
    }
   },
   "periodic": false
  }
 },
 "clock": {
  "mode": "value",
  "channels": [
   "t"
  ],
  "steps": 8,
  "range": [
   0.0,
   2.0
  ]
 },
 "views": {
  "rot": {
   "frame": "rot",
   "driver": {
    "sets": {
     "set": "drv"
    },
    "member": {
     "index": 0
    }
   },
   "layers": [
    {
     "kind": "track",
     "sets": {
      "set": "drv"
     },
     "members": "all"
    },
    {
     "kind": "outline",
     "view": "closeup",
     "color": "#ffffff",
     "opacity": 0.5,
     "width": 1.5,
     "dash": [
      4,
      3
     ],
     "min_size": 12
    }
   ]
  },
  "inertial": {
   "frame": "inertial",
   "driver": {
    "sets": {
     "set": "drv"
    },
    "member": {
     "index": 0
    }
   },
   "layers": [
    {
     "kind": "track",
     "sets": {
      "set": "drv"
     },
     "members": "all"
    },
    {
     "kind": "outline",
     "view": "closeup",
     "color": "#ffffff",
     "opacity": 0.5,
     "width": 1.5,
     "dash": [
      4,
      3
     ],
     "min_size": 12
    }
   ]
  },
  "closeup": {
   "frame": "zoom",
   "driver": {
    "sets": {
     "set": "drv"
    },
    "member": {
     "index": 0
    }
   },
   "layers": [
    {
     "kind": "track",
     "sets": {
      "set": "drv"
     },
     "members": "all"
    }
   ],
   "camera": {
    "kind": "plane",
    "plane": "xy"
   }
  },
  "lost": {
   "frame": "rot",
   "driver": {
    "sets": {
     "tags": {
      "g": "none"
     }
    },
    "member": {
     "index": 0
    }
   },
   "layers": [
    {
     "kind": "outline",
     "view": "closeup",
     "color": "#ffffff",
     "opacity": 0.5,
     "width": 1.5,
     "dash": [
      4,
      3
     ],
     "min_size": 12
    }
   ]
  }
 },
 "initial": {
  "variables": {},
  "clock": {
   "channel": "t"
  },
  "panels": {
   "rot": {
    "view": "rot"
   },
   "inertial": {
    "view": "inertial"
   },
   "closeup": {
    "view": "closeup"
   }
  },
  "layout": {
   "kind": "split",
   "dir": "row",
   "ratio": 0.5,
   "a": {
    "kind": "panel",
    "id": "rot"
   },
   "b": {
    "kind": "split",
    "dir": "row",
    "ratio": 0.5,
    "a": {
     "kind": "panel",
     "id": "inertial"
    },
    "b": {
     "kind": "panel",
     "id": "closeup"
    }
   }
  }
 }
}
